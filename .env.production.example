# Plantilla de variables de PRODUCCION para apps/api.
#
# NINGUN valor de este archivo es un secreto real: son marcadores. Los
# valores reales se inyectan como variables de entorno en la plataforma que
# ejecute el contenedor (docs/22_INFRASTRUCTURE_IMPLEMENTATION_PLAN.md
# seccion 7: gestion de secretos externa). Nunca se comprometen al
# repositorio ni se hornean en la imagen.
#
# El contrato lo define packages/validation/src/env/*.ts y lo valida
# packages/config/src/server.ts al arrancar: si falta una variable
# obligatoria, el proceso NO arranca.

# --- OBLIGATORIAS: sin default, el API no arranca sin ellas ----------------

# Cadena de conexion de PostgreSQL administrado. Exigir TLS en produccion.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/contaia?sslmode=require

# Minimo 32 caracteres cada uno. Generar uno DISTINTO por ambiente con:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=GENERAR_32_CARACTERES_MINIMO_UNICO_POR_AMBIENTE
MFA_ENCRYPTION_KEY=GENERAR_32_CARACTERES_MINIMO_UNICO_POR_AMBIENTE
CSRF_SECRET=GENERAR_32_CARACTERES_MINIMO_UNICO_POR_AMBIENTE

# --- OBLIGATORIAS EN LA PRACTICA: tienen default, pero el default es local -

NODE_ENV=production

# Activa `secure: true` en las cookies de sesion (token.service.ts). Sin
# NODE_ENV=production las cookies viajarian sin el atributo Secure.

# Origen EXACTO del frontend, con esquema y sin barra final. Acepta varios
# separados por coma. El default es http://localhost:3000 — invalido en
# produccion.
CORS_ORIGINS=https://app.EJEMPLO.mx

# Dominio padre COMPARTIDO entre el frontend y el API.
#
# CRITICO — leer antes de elegir hosting: las cookies de sesion se emiten con
# SameSite=Lax (apps/api/src/modules/authentication/services/token.service.ts).
# Una cookie Lax NO se envia en peticiones cross-site, y apps/web llama al API
# directamente desde el navegador con credentials:'include'
# (apps/web/src/lib/http.ts). Por lo tanto el frontend y el API DEBEN
# compartir dominio registrable:
#
#   web -> https://app.EJEMPLO.mx     API -> https://api.EJEMPLO.mx
#   SESSION_COOKIE_DOMAIN=.EJEMPLO.mx
#
# Un frontend en *.vercel.app con un API en otro dominio (*.onrender.com,
# *.fly.dev, etc.) es cross-site: el login respondera 200 pero ninguna
# peticion posterior llevara la sesion. No es un bug a parchear aqui — es el
# modelo de seguridad ratificado (CSRF de doble cookie sobre cookies
# HttpOnly same-site).
SESSION_COOKIE_DOMAIN=.EJEMPLO.mx

# --- OPCIONALES: el default sirve, se listan para que sean explicitas ------

# Muchas plataformas inyectan su propio puerto. Si lo hacen, API_PORT debe
# recibir ese MISMO valor.
API_PORT=4000
API_GLOBAL_PREFIX=api

# Redis hoy solo se usa para una comprobacion de readiness NO critica
# (apps/api/src/redis/redis.service.ts). No hay colas ni workers en el
# codigo. Dejarlo en false evita reportar un servicio caido que no existe.
# Cambiar a true cuando exista una instancia real de Redis.
REDIS_ENABLED=false

# Almacenamiento de objetos: sin modulo que lo consuma en esta rama.
STORAGE_ENABLED=false

APP_VERSION=0.1.0
LOG_LEVEL=info

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ISSUER_NAME=ContaIA
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
INVITATION_TOKEN_TTL_DAYS=7
