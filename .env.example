# Variables de entorno de ContaIA — copiar a `.env` y ajustar segun el
# entorno local. Ningun valor aqui es un secreto real
# (docs/22_INFRASTRUCTURE_IMPLEMENTATION_PLAN.md seccion 7).
#
# `.env` esta en .gitignore — nunca se sube al repositorio.

# --- Compartidas (frontend y backend) --------------------------------------
NODE_ENV=development
APP_VERSION=0.1.0

# --- Frontend (apps/web) ----------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Backend (apps/api) ------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Autenticacion y autorizacion (EWO-002) ---------------------------------
# Valores de ejemplo NO validos para produccion — generar secretos reales de
# al menos 32 caracteres (p. ej. `openssl rand -base64 48`) por ambiente.
JWT_ACCESS_SECRET=dev_only_change_me_jwt_access_secret_32chars_min
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ENCRYPTION_KEY=dev_only_change_me_mfa_encryption_key_32chars_min
MFA_ISSUER_NAME=ContaIA
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
INVITATION_TOKEN_TTL_DAYS=7
CSRF_SECRET=dev_only_change_me_csrf_secret_32chars_min

# --- Base de datos (PostgreSQL via Prisma, packages/database) --------------
DATABASE_URL=postgresql://contaia:contaia_dev_only@localhost:5432/contaia
POSTGRES_DB=contaia
POSTGRES_USER=contaia
POSTGRES_PASSWORD=contaia_dev_only
POSTGRES_PORT=5432

# --- Redis (preparado, sin uso funcional de colas todavia) -----------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_PORT=6379

# --- Almacenamiento compatible con S3 (MinIO, EWO-005) --------------------
MINIO_ROOT_USER=contaia_dev
MINIO_ROOT_PASSWORD=contaia_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

STORAGE_ENABLED=true
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=contaia_dev
STORAGE_SECRET_KEY=contaia_dev_only
STORAGE_BUCKET=contaia-documents

# --- Worker BullMQ y limites XML (EWO-005 Bloque E, Addendum §10.3) --------
# 14 variables centrales, fail-fast: un valor fuera de rango hace fallar el
# arranque; ausente aplica el default MVP. Ningun consumidor (productor,
# worker, reconciliador) debe declarar su propio default local.
XML_MAX_FILE_SIZE_BYTES=10485760
XML_MAX_DEPTH=50
XML_MAX_NODE_COUNT=100000
XML_MAX_ATTRIBUTE_COUNT=50000

JOBS_RECONCILIATION_ENABLED=true
JOBS_RECONCILIATION_INTERVAL_MS=300000
JOBS_STALE_QUEUED_MS=600000
JOBS_STALE_PROCESSING_MS=900000
JOBS_ATTEMPTS=3
JOBS_BACKOFF_DELAY_MS=5000
JOBS_REMOVE_ON_COMPLETE_COUNT=1000
JOBS_REMOVE_ON_COMPLETE_AGE_SECONDS=86400
JOBS_REMOVE_ON_FAIL_COUNT=5000
JOBS_REMOVE_ON_FAIL_AGE_SECONDS=604800

# --- Observabilidad ----------------------------------------------------------
LOG_LEVEL=info
