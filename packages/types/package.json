{
  "name": "@contaia/types",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos TypeScript compartidos entre apps/web y apps/api (sin logica de negocio).",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@contaia/eslint-config": "workspace:*",
    "@contaia/typescript-config": "workspace:*",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
